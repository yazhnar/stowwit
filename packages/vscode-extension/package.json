{
  "name": "stowwit-vscode",
  "displayName": "stowwit",
  "description": "Semantic Git stash browser — view AI-summarized stashes without leaving the editor.",
  "version": "0.1.0",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": ["SCM Providers", "Other"],
  "activationEvents": [
    "onCommand:stowwit.open"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "stowwit.open",
        "title": "stowwit: Open Stash Browser"
      }
    ]
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "package": "vsce package",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/vscode": "^1.90.0",
    "@types/node": "^22.9.0",
    "@vscode/vsce": "^3.2.1",
    "typescript": "^5.6.3"
  },
  "license": "MIT"
}
