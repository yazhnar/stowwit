# --- stowwit core engine configuration ---

# Port the local Express API listens on
PORT=3000

# Absolute path to the git repository stowwit should index.
# Defaults to the current working directory if omitted.
REPO_PATH=.

# Where to store the SQLite index file.
DB_PATH=./data/stowwit.db

# --- AI provider routing ---
# One of: ollama | gemini | claude
LLM_PROVIDER=ollama

# Used when LLM_PROVIDER=ollama (fully local, no data leaves your machine)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder

# Used when LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Used when LLM_PROVIDER=claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-3-5-haiku-latest
