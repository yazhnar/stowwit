{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "stowwit",
  "version": "0.1.0",
  "identifier": "dev.stowwit.desktop",
  "build": {
    "frontendDist": "../../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev --workspace=packages/ui",
    "beforeBuildCommand": "npm run build --workspace=packages/ui"
  },
  "app": {
    "windows": [
      {
        "title": "stowwit",
        "width": 1200,
        "height": 800,
        "minWidth": 860,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [],
    "resources": []
  }
}
